app_identifier("com.hobbylabo.officast")

# 메타데이터/스크린샷 경로 (기본값과 동일하지만 명시).
metadata_path("./fastlane/metadata")
screenshots_path("./fastlane/screenshots")

# 이번엔 메타데이터+스크린샷만 올린다. 바이너리는 별도(pilot/Xcode)로 업로드.
skip_binary_upload(true)

# 첫 등록 검토 단계에서는 자동 심사 제출을 끈다. 확인 후 수동 제출 권장.
submit_for_review(false)

# 심사 통과 후 수동 릴리스.
automatic_release(false)

# IAP 없음.
precheck_include_in_app_purchases(false)

# 로컬라이즈드 메타데이터를 소스 오브 트루스로 사용(ASC 값을 덮어쓴다).
overwrite_screenshots(true)

# 심사 제출 신고 항목(콘텐츠 권한·수출 규정). submit_for_review(true) 시 적용된다.
# fastlane 기본값은 content_rights_contains_third_party_content=false 인데, 이 앱은
# Open-Meteo 날씨·MapKit 검색 결과 등 타사 콘텐츠를 표시하므로 명시적으로 true로 교정한다.
submission_information({
  export_compliance_uses_encryption: false,          # Info.plist ITSAppUsesNonExemptEncryption=false와 일치
  content_rights_contains_third_party_content: true,  # Open-Meteo 날씨·MapKit 검색 결과 등 표시
  content_rights_has_rights: true,                    # 사용 허가 보유(Open-Meteo CC BY 4.0 등)
  add_id_info_uses_idfa: false                        # 광고 식별자 미사용(광고/애널리틱스 없음)
})
