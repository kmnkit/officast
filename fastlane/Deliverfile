app_identifier("com.hobbylabo.officast")

# 메타데이터/스크린샷 경로 (기본값과 동일하지만 명시).
metadata_path("./fastlane/metadata")
screenshots_path("./fastlane/screenshots")

# 이번엔 메타데이터+스크린샷만 올린다. 바이너리는 별도(pilot/Xcode)로 업로드.
skip_binary_upload(true)

# 첫 등록 검토 단계에서는 자동 심사 제출을 끈다. 확인 후 수동 제출 권장.
submit_for_review(false)

# 심사 통과 후 수동 릴리스.
automatic_release(false)

# IAP 없음.
precheck_include_in_app_purchases(false)

# 로컬라이즈드 메타데이터를 소스 오브 트루스로 사용(ASC 값을 덮어쓴다).
overwrite_screenshots(true)
